# Database
DB_USER=warathah
DB_PASS=warathah_secure_password_here

# JWT (generate a secure 256-bit key for production)
JWT_SECRET=warathah-secret-key-change-in-production-must-be-at-least-256-bits-long

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# CORS
ALLOWED_ORIGINS=http://localhost:3000
# اختياري: رقم واتساب للتواصل (يتقدّم على رقم المستخدم المسجّل) — بصيغة دولية أو محلية
# WHATSAPP_NUMBER="9665XXXXXXXX"
# رابط الموقع الأساسي (مطلوب في الإنتاج لـ SEO: canonical/sitemap/OG)
NEXT_PUBLIC_SITE_URL="https://waratha.app"
# اختياري: Google Analytics 4 — اتركه فارغاً لتعطيل GA (التتبع الداخلي يعمل دائماً)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ===== بيانات الجهة المشغّلة (إلزامية للامتثال القانوني قبل الإطلاق) =====
# تُضبط في .env محلياً وفي متغيرات بيئة الاستضافة للإنتاج — تظهر في سياسة الخصوصية وشروط الاستخدام
# NEXT_PUBLIC_OPERATOR_ENTITY="اسم الكيان القانوني / المؤسسة"
# NEXT_PUBLIC_OPERATOR_CR="رقم السجل التجاري"
# NEXT_PUBLIC_OPERATOR_ADDRESS="العنوان الوطني"
# NEXT_PUBLIC_OPERATOR_EMAIL="support@waratha.app"
# NEXT_PUBLIC_OPERATOR_DPO="privacy@waratha.app"
# TRUSTED_PROXY="true"   # فعّلها فقط خلف بروكسي موثوق (لتحديد معدّل الدخول بدقة)
